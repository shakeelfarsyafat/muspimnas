<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sistem Sidang & Verifikasi QR' %> | MUSPIMNAS</title>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              800: '#3730a3',
              900: '#312e81',
            }
          }
        }
      }
    }
  </script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/custom.css">

  <!-- Global Toast & Audio Synthesizer -->
  <script src="/js/toast.js"></script>
  <script src="/js/audio.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Navbar (Only shown when admin is logged in) -->
  <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
  <nav class="no-print sticky top-0 z-40 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white transition-all shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">
        
        <!-- Brand Logo -->
        <div class="flex items-center space-x-2.5 flex-shrink-0">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center shadow-md shadow-indigo-500/20">
            <i class="fas fa-qrcode text-sm text-white"></i>
          </div>
          <div>
            <div class="flex items-center space-x-1.5 leading-none">
              <a href="/dashboard" class="text-sm font-black tracking-tight text-white hover:text-indigo-300 transition">
                MUSPIMNAS
              </a>
              <span class="text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-indigo-900/80 text-indigo-300 border border-indigo-700/60">
                Internal
              </span>
            </div>
            <p class="text-[10px] text-slate-400 font-medium leading-none mt-1">Sistem Pintu Sidang</p>
          </div>
        </div>

        <!-- Navigation Menu Links (Single-line pills, neat horizontal spacing) -->
        <div class="hidden md:flex items-center space-x-1.5">
          <a href="/dashboard" class="px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all flex items-center space-x-1.5 <%= typeof currentPath !== 'undefined' && (currentPath === '/dashboard' || currentPath === '/') ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
            <i class="fas fa-users text-xs opacity-75"></i>
            <span>Peserta Sidang</span>
          </a>

          <a href="/rooms" class="px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all flex items-center space-x-1.5 <%= typeof currentPath !== 'undefined' && currentPath === '/rooms' ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
            <i class="fas fa-door-open text-xs opacity-75"></i>
            <span>Ruangan Sidang</span>
          </a>

          <a href="/scanner" class="px-3 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap transition-all flex items-center space-x-1.5 <%= typeof currentPath !== 'undefined' && currentPath === '/scanner' ? 'bg-emerald-600 text-white shadow-xs' : 'text-emerald-400 hover:text-emerald-300 hover:bg-slate-800' %>">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <i class="fas fa-desktop text-xs"></i>
            <span>Layar Monitor</span>
          </a>

          <a href="/scanner/camera" class="px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all flex items-center space-x-1.5 <%= typeof currentPath !== 'undefined' && currentPath === '/scanner/camera' ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
            <i class="fas fa-camera text-xs text-indigo-400"></i>
            <span>Kamera HP Pintu</span>
          </a>

          <a href="/print?ids=all" target="_blank" class="px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center space-x-1.5">
            <i class="fas fa-print text-xs opacity-75"></i>
            <span>Cetak Semua ID</span>
          </a>
        </div>

        <!-- Admin Profile & Logout -->
        <div class="flex items-center space-x-2.5 flex-shrink-0">
          <div class="hidden sm:flex items-center space-x-1.5 px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 text-xs">
            <span class="w-5 h-5 rounded-full bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-indigo-400 text-[10px]">
              <i class="fas fa-user-shield"></i>
            </span>
            <span class="font-bold text-slate-200 text-xs"><%= currentAdmin.username %></span>
          </div>

          <a href="/logout" class="px-2.5 py-1 rounded-lg bg-rose-500/10 text-rose-400 hover:bg-rose-600 hover:text-white border border-rose-500/20 transition-all text-xs font-bold flex items-center space-x-1" title="Keluar dari Sistem">
            <i class="fas fa-arrow-right-from-bracket text-[11px]"></i>
            <span>Logout</span>
          </a>
        </div>

      </div>
    </div>
  </nav>
  <% } %>

  <main class="flex-1">

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sistem Sidang & Verifikasi QR' %> | MUSPIMNAS</title>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              800: '#3730a3',
              900: '#312e81',
            }
          }
        }
      }
    }
  </script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/custom.css">

  <!-- Audio Synthesizer -->
  <script src="/js/audio.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Navbar (Only shown when admin is logged in) -->
  <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
  <nav class="no-print sticky top-0 z-40 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white transition-all shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Brand Logo -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/30">
            <i class="fas fa-qrcode text-xl text-white"></i>
          </div>
          <div>
            <a href="/dashboard" class="text-base font-bold tracking-tight text-white hover:text-indigo-300 transition">
              MUSPIMNAS <span class="text-indigo-400 font-normal text-xs uppercase px-1.5 py-0.5 rounded bg-indigo-900/60 border border-indigo-700/50 ml-1">Internal</span>
            </a>
            <p class="text-[11px] text-slate-400 font-medium">Sistem Peserta & Verifikasi Pintu Sidang</p>
          </div>
        </div>

        <!-- Navigation Menu Links -->
        <div class="hidden md:flex items-center space-x-1">
          <a href="/dashboard" class="px-3.5 py-2 rounded-lg text-sm font-medium transition <%= currentPath === '/dashboard' || currentPath === '/' ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
            <i class="fas fa-users mr-1.5 text-xs opacity-75"></i> Peserta Sidang
          </a>
          <a href="/rooms" class="px-3.5 py-2 rounded-lg text-sm font-medium transition <%= currentPath === '/rooms' ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
            <i class="fas fa-door-open mr-1.5 text-xs opacity-75"></i> Ruangan Sidang
          </a>
          <a href="/scanner" class="px-3.5 py-2 rounded-lg text-sm font-semibold transition flex items-center <%= currentPath === '/scanner' ? 'bg-emerald-600 text-white shadow-emerald-500/25 shadow-lg' : 'text-emerald-400 hover:text-emerald-300 hover:bg-slate-800' %>">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-2"></span>
            <i class="fas fa-barcode mr-1.5 text-xs"></i> Pintu Sidang (Scanner)
          </a>
          <a href="/print?ids=all" target="_blank" class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition">
            <i class="fas fa-print mr-1.5 text-xs opacity-75"></i> Cetak Semua ID
          </a>
        </div>

        <!-- Admin Profile & Logout -->
        <div class="flex items-center space-x-3">
          <div class="hidden sm:flex items-center space-x-2 text-right">
            <div class="text-xs">
              <span class="text-slate-400">Petugas:</span>
              <span class="font-bold text-slate-200 block"><%= currentAdmin.username %></span>
            </div>
            <div class="w-8 h-8 rounded-full bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-indigo-400 text-xs font-bold">
              <i class="fas fa-user-shield"></i>
            </div>
          </div>
          <a href="/logout" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-rose-500/10 text-rose-400 hover:bg-rose-600 hover:text-white border border-rose-500/20 transition flex items-center" title="Keluar dari Sistem">
            <i class="fas fa-sign-out-alt mr-1"></i> Logout
          </a>
        </div>

      </div>
    </div>
  </nav>
  <% } %>

  <!-- Main View Slot -->
  <main class="flex-1">
    <%- body %>
  </main>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col space-y-3 pointer-events-none max-w-sm w-full"></div>

</body>
</html>
